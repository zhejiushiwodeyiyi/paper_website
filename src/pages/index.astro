---
import { siteContent } from '../data/site';

const normalizedBaseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const assetUrl = (relativePath: string) =>
  normalizedBaseUrl === '/' ? `./${relativePath}` : `${normalizedBaseUrl}${relativePath}`;

const resourceHrefByKind: Record<string, string> = {
  manuscript: assetUrl(siteContent.assetPaths.manuscriptPdf),
  site: siteContent.links.siteRepoUrl,
};
---
<html lang={siteContent.metadata.lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{siteContent.metadata.title}</title>
  <meta name="description" content={siteContent.metadata.description} />
  <style is:inline>
    @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=IBM+Plex+Sans:wght@300;400;500&display=swap');
    :root{--bg:#f8fbff;--card:#fff;--ink:#0f172a;--muted:#475569;--line:#c8d8ee;--accent:#1e40af;--str:#cc79a7;--emo:#e69f00;--csf:#56b4e9;--spf:#009e73;--phy:#d55e00}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.7 'IBM Plex Sans',sans-serif}h1,h2,h3,h4{font-family:'DM Serif Display',serif;line-height:1.1;margin:0 0 .7rem}a{color:var(--accent);text-decoration:none}img{max-width:100%;display:block}
    .wrap{width:min(1100px,calc(100vw - 40px));margin:0 auto}.nav{position:sticky;top:0;z-index:10;background:rgba(255,255,255,.9);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}.nav .wrap{display:flex;justify-content:space-between;align-items:center;padding:12px 0}.brand{display:flex;gap:10px;align-items:center;color:var(--ink)}.mark{width:30px;height:30px;border-radius:8px;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:.72rem}.links{display:flex;gap:10px;flex-wrap:wrap}.links a{padding:6px 12px;border-radius:999px;color:var(--muted)}.links a:hover{background:#eef4ff;color:var(--accent)}
    .hero{padding:88px 0 56px;text-align:center}.kicker{font-size:.75rem;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)}.hero h1{font-size:clamp(2.8rem,7vw,5rem)}.hero .accent{color:var(--accent)}.hero p{max-width:60ch;margin:0 auto 22px;color:var(--muted)}.btns,.stats,.domains,.resources{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}.btn,.res{border:1px solid var(--line);background:#fff;border-radius:999px;padding:10px 16px}.stats{margin:26px 0}.stat strong{display:block;font:clamp(1.7rem,3.4vw,2.5rem)/1 'DM Serif Display',serif}.stat span{font-size:.74rem;color:var(--muted);letter-spacing:.1em;text-transform:uppercase}.domains span{display:inline-flex;gap:8px;align-items:center;color:var(--muted)}.domains i{width:10px;height:10px;border-radius:50%}
    section{padding:56px 0}.head{margin-bottom:24px}.head .label{font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:var(--accent)}.head p{max-width:64ch;color:var(--muted)}.grid2,.grid3{display:grid;gap:16px}.grid2{grid-template-columns:repeat(2,minmax(0,1fr))}.grid3{grid-template-columns:repeat(3,minmax(0,1fr))}.card,.figure,.res,.gloss{background:var(--card);border:1px solid var(--line);border-radius:16px}.card,.gloss{padding:20px}.figure{overflow:hidden}.cap{padding:10px 14px;border-top:1px solid var(--line);color:var(--muted);font-size:.84rem}.res{display:flex;gap:12px;align-items:center;padding:16px}.icon{width:36px;height:36px;border-radius:10px;background:#eef4ff;color:var(--accent);display:grid;place-items:center;font-size:.72rem}.res span,.gloss dd{color:var(--muted);font-size:.84rem}.citation{margin-top:28px;padding-top:20px;border-top:1px solid var(--line);color:var(--muted);font-size:.84rem}
    @media (max-width:960px){.grid2,.grid3{grid-template-columns:1fr}.links{display:none}}
  </style>
</head>
<body>
  <nav class="nav">
    <div class="wrap">
      <a href="#" class="brand"><span class="mark">{siteContent.nav.brandMark}</span>{siteContent.nav.brandText}</a>
      <div class="links">{siteContent.nav.links.map((link) => <a href={link.href}>{link.label}</a>)}</div>
    </div>
  </nav>

  <section class="hero">
    <div class="wrap">
      <div class="kicker">{siteContent.hero.overline}</div>
      <h1>{siteContent.hero.titleLead}<br /><span class="accent">{siteContent.hero.titleAccent}</span></h1>
      <p>{siteContent.hero.summary}</p>
      <div class="btns">
        {siteContent.hero.ctas.map((cta) => (
          <a class="btn" href={resourceHrefByKind[cta.kind]} target="_blank" rel="noopener noreferrer">{cta.label}</a>
        ))}
      </div>
      <div class="stats">
        {siteContent.hero.stats.map((stat) => (
          <div class="stat"><strong>{stat.value.toLocaleString()}</strong><span>{stat.label}</span></div>
        ))}
      </div>
      <div class="domains">
        {siteContent.hero.domains.map((domain) => (
          <span><i style={`background:${domain.colorVar}`}></i>{domain.label}</span>
        ))}
      </div>
    </div>
  </section>

  <section id="summary">
    <div class="wrap">
      <div class="head">
        <div class="label">{siteContent.summary.label}</div>
        <h2>{siteContent.summary.title}</h2>
        <p>{siteContent.summary.subtitle}</p>
      </div>
      <div class="grid2">
        {siteContent.summary.cards.map((card) => (
          <div class="card"><h4>{card.number} {card.title}</h4><p>{card.body}</p></div>
        ))}
      </div>
      <div class="figure" style="margin-top:16px">
        <img src={assetUrl(siteContent.assetPaths.summaryCoreFigure)} alt="Summary figure" />
        <div class="cap">{siteContent.summary.figureCaption}</div>
      </div>
    </div>
  </section>

  <section id="phases">
    <div class="wrap">
      <div class="head">
        <div class="label">{siteContent.phases.label}</div>
        <h2>{siteContent.phases.title}</h2>
        <p>{siteContent.phases.subtitle}</p>
      </div>
      <div class="grid3">
        {siteContent.phases.legendItems.map((item) => (
          <div class="card">
            <div class="label" style={`color:${item.colorVar}`}>{item.short}</div>
            <h4>{item.label}</h4>
            <p>{siteContent.phases.legendNote}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="backbone">
    <div class="wrap">
      <div class="head">
        <div class="label">{siteContent.backbone.label}</div>
        <h2>{siteContent.backbone.title}</h2>
        <p>{siteContent.backbone.subtitle}</p>
      </div>
      <div class="grid2">
        <div class="card">
          <h4>{siteContent.backbone.listTitle}</h4>
          <p>{siteContent.backbone.listNote}</p>
          {siteContent.backbone.detailTags.map((tag) => (
            <span class="btn" style="display:inline-block;margin:0 8px 8px 0;padding:4px 10px">{tag}</span>
          ))}
          {[
            'PSS12 showed the highest recurring structural coverage frequency (0.750).',
            'Stress and sleep indicators appeared repeatedly in minimal structural coverage solutions.',
            'Negative stress showed the strongest outbound AMCS pathway to positive stress (0.643).',
            'Sleep showed notable outbound coverage to anxiety (0.347) and depression (0.312).',
            'Anxiety also showed substantial coverage toward depression (0.438).',
          ].map((item) => <div style="padding:8px 0;border-top:1px solid var(--line)">{item}</div>)}
        </div>
        <div class="figure">
          <img src={assetUrl(siteContent.assetPaths.backboneFigure)} alt="Backbone figure" />
          <div class="cap">{siteContent.backbone.figureCaption}</div>
        </div>
      </div>
      <div class="grid3" style="margin-top:16px">
        {siteContent.backbone.macroCards.map((card) => <div class="card"><h4>{card.title}</h4><p>{card.body}</p></div>)}
      </div>
      <div class="card" style="margin-top:16px"><p>{siteContent.backbone.macroDisclaimer}</p></div>
    </div>
  </section>

  <section id="methods">
    <div class="wrap">
      <div class="head">
        <div class="label">{siteContent.methods.label}</div>
        <h2>{siteContent.methods.title}</h2>
        <p>{siteContent.methods.subtitle}</p>
      </div>
      <div class="grid3">
        {siteContent.methods.steps.map((step) => <div class="card"><h4>{step.number} {step.title}</h4><p>{step.body}</p></div>)}
      </div>
    </div>
  </section>

  <section id="robustness">
    <div class="wrap">
      <div class="head">
        <div class="label">{siteContent.robustness.label}</div>
        <h2>{siteContent.robustness.title}</h2>
        <p>{siteContent.robustness.subtitle}</p>
      </div>
      <div class="grid2">
        <div class="figure">
          <img src={assetUrl(siteContent.assetPaths.robustnessFigure)} alt="Results figure" />
          <div class="cap">{siteContent.robustness.figureCaption}</div>
        </div>
        <div class="grid2">
          {siteContent.robustness.notes.map((note) => <div class="card"><h4>{note.title}</h4><p>{note.body}</p></div>)}
        </div>
      </div>
    </div>
  </section>

  <section id="significance">
    <div class="wrap">
      <div class="head">
        <div class="label">{siteContent.significance.label}</div>
        <h2>{siteContent.significance.title}</h2>
      </div>
      <div class="grid3">
        {siteContent.significance.cards.map((card) => (
          <div class="card"><div class="label">{card.category}</div><h4>{card.title}</h4><p>{card.body}</p></div>
        ))}
      </div>
      <div class="grid2" style="margin-top:16px">
        {siteContent.significance.limits.map((limit) => <div class="card"><h4>{limit.title}</h4><p>{limit.body}</p></div>)}
      </div>
    </div>
  </section>

  <footer id="resources">
    <div class="wrap">
      <div class="head"><div class="label">{siteContent.glossary.label}</div></div>
      <div class="grid2">
        {siteContent.glossary.items.map((item) => (
          <dl class="gloss"><dt><strong>{item.term}</strong>{item.tag ? ` (${item.tag})` : ''}</dt><dd>{item.body}</dd></dl>
        ))}
      </div>
      <div class="head" style="margin-top:28px"><div class="label">{siteContent.resources.label}</div></div>
      <div class="resources">
        {siteContent.resources.items.map((item) => (
          <a class="res" href={resourceHrefByKind[item.kind]} target="_blank" rel="noopener noreferrer">
            <span class="icon">{item.icon}</span>
            <div><strong>{item.title}</strong><span>{item.body}</span></div>
          </a>
        ))}
      </div>
      <div class="citation">{siteContent.resources.citation}</div>
    </div>
  </footer>
</body>
</html>
